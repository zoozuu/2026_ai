<script>
(()=>{
const START=[[1,2,3],[7,4,5],[0,8,6]];
const GOAL=[[1,2,3],[4,5,6],[7,8,0]];

let nextId=1;
let rootNode=null;
let activeNode=null;
let selectedPath=[];
let completed=false;
let moveAnimating=false;

const clone=b=>b.map(r=>[...r]);
const key=b=>b.flat().join(',');

function score(board){
  let s=0;
  for(let r=0;r<3;r++){
    for(let c=0;c<3;c++){
      if(board[r][c]!==0 && board[r][c]===GOAL[r][c]) s++;
    }
  }
  return s;
}

function blank(board){
  for(let r=0;r<3;r++)for(let c=0;c<3;c++)if(board[r][c]===0)return[r,c];
}

function possibleMoves(board,parentBoard){
  const [br,bc]=blank(board);
  const dirs=[[-1,0],[1,0],[0,-1],[0,1]];
  const moves=[];
  for(const [dr,dc] of dirs){
    const nr=br+dr,nc=bc+dc;
    if(nr<0||nr>2||nc<0||nc>2) continue;
    const next=clone(board);
    next[br][bc]=next[nr][nc];
    next[nr][nc]=0;
    if(parentBoard && key(next)===key(parentBoard)) continue;
    moves.push({r:nr,c:nc,board:next});
  }
  return moves;
}

function makeNode(board,parent=null){
  return {
    id:nextId++,
    board:clone(board),
    parent,
    children:[],
    actual:score(board),
    selectedTiles:new Set(),
    manualInput:'',
    checked:false,
    selected:false,
    rejected:false,
    expandedComplete:false,
    element:null,
    fresh:false
  };
}

function setStatus(html,type=''){
  const el=document.getElementById('status');
  el.className='status'+(type?' '+type:'');
  el.innerHTML=html;
}

function renderStaticBoard(el,board){
  el.innerHTML='';
  board.flat().forEach(v=>{
    const d=document.createElement('div');
    d.className='tile'+(v===0?' blank':'');
    d.textContent=v===0?'-':v;
    el.appendChild(d);
  });
}

function childAlreadyExists(node,board){
  return node.children.some(ch=>key(ch.board)===key(board));
}

async function generateChild(node,move,sourceButton){
  if(completed || node!==activeNode || moveAnimating) return;

  if(childAlreadyExists(node,move.board)){
    setStatus('이미 만든 후보 상태입니다. 다른 파란색 숫자를 움직여 보세요.','warn');
    return;
  }

  moveAnimating=true;

  // 현재 노드 안에서 클릭한 조각이 빈칸으로 실제 이동하는 모습을 보여줌
  const card=node.element;
  const boardEl=sourceButton?.closest('.board');
  const blankEl=boardEl?.querySelector('.tile.blank');

  if(card) card.classList.add('moving');

  if(sourceButton && blankEl){
    const srcRect=sourceButton.getBoundingClientRect();
    const dstRect=blankEl.getBoundingClientRect();

    const dx=dstRect.left-srcRect.left;
    const dy=dstRect.top-srcRect.top;

    sourceButton.classList.add('slide-piece');
    blankEl.classList.add('slide-target');

    // 레이아웃 확정 후 transform 적용
    requestAnimationFrame(()=>{
      sourceButton.style.transform=`translate(${dx}px, ${dy}px)`;
    });

    await new Promise(resolve=>setTimeout(resolve,410));

    sourceButton.style.transform='';
    sourceButton.classList.remove('slide-piece');
    blankEl.classList.remove('slide-target');
  }

  if(card) card.classList.remove('moving');

  // 이동한 결과를 아래 자식 노드로 생성
  const child=makeNode(move.board,node);
  child.fresh=true;
  node.children.push(child);

  const all=possibleMoves(node.board,node.parent?node.parent.board:null);

  if(node.children.length===all.length){
    node.expandedComplete=true;
    setStatus('✓ 가능한 다음 상태를 모두 만들었습니다. 이제 각 후보의 f(n)을 계산하세요.');
  }else{
    setStatus(
      '아직 가능한 이동이 남아 있습니다. 현재 <b>'+node.children.length+' / '+all.length+
      '</b>개의 후보를 만들었습니다.<br>현재 상태로 돌아가 남은 가능한 이동도 모두 만들어 주세요.',
      'warn'
    );
  }

  render();

  setTimeout(()=>{
    child.fresh=false;
    moveAnimating=false;
  },650);
}

function toggleScoreTile(node,r,c){
  if(node.checked || node.board[r][c]===0) return;

  const k=r+'-'+c;
  if(node.selectedTiles.has(k)) node.selectedTiles.delete(k);
  else node.selectedTiles.add(k);

  // 클릭한 개수를 하나의 f(n) 입력값과 동기화
  node.manualInput=String(node.selectedTiles.size);

  // 정답 개수만큼 선택한 순간 자동 검증
  if(node.selectedTiles.size===node.actual){
    verifyScore(node,null,true);
  }else{
    render();
  }
}

function verifyScore(node,inputEl,fromClicks=false){
  if(node.parent && !node.parent.expandedComplete){
    const total=possibleMoves(
      node.parent.board,
      node.parent.parent ? node.parent.parent.board : null
    ).length;
    setStatus(
      '아직 모든 후보 상태를 만들지 않았습니다. 현재 <b>'+
      node.parent.children.length+' / '+total+
      '</b>개입니다.<br>남은 가능한 이동을 먼저 모두 만들어 주세요.',
      'warn'
    );
    return;
  }
  const raw=(inputEl?.value ?? node.manualInput ?? '').trim();

  if(raw===''){
    if(!fromClicks) setStatus('f(n) 값을 입력하세요.','warn');
    return;
  }

  const val=Number(raw);
  if(!Number.isInteger(val)||val<0||val>8){
    if(!fromClicks) setStatus('f(n)은 0~8 사이의 정수로 입력하세요.','warn');
    return;
  }

  node.manualInput=String(val);

  // 클릭으로 계산한 경우에는 선택한 숫자 조각도 모두 정확해야 함
  if(node.selectedTiles.size>0){
    const correct=new Set();
    for(let r=0;r<3;r++)for(let c=0;c<3;c++){
      if(node.board[r][c]!==0 && node.board[r][c]===GOAL[r][c]){
        correct.add(r+'-'+c);
      }
    }

    const clickExact =
      node.selectedTiles.size===correct.size &&
      [...node.selectedTiles].every(x=>correct.has(x));

    if(!clickExact){
      setStatus('선택한 숫자 중 목표 위치와 일치하지 않는 숫자가 있습니다. 다시 선택해 보세요.','warn');
      render();
      return;
    }
  }

  if(val!==node.actual){
    setStatus('입력한 f(n)이 맞지 않습니다. 목표 위치와 같은 숫자의 개수를 다시 확인해 보세요.','warn');
    return;
  }

  node.checked=true;

  if(node===rootNode && selectedPath.length===0){
    node.selected=true;
    selectedPath=[node];
    activeNode=node;
    setStatus('✓ 초기 상태의 f(n)을 정확히 계산했습니다. 이제 파란색 숫자를 움직여 후보 상태를 모두 만들어 보세요.');
  } else {
    const siblings=node.parent.children;
    if(siblings.every(n=>n.checked)){
      setStatus('✓ 모든 후보의 f(n)을 계산했습니다. 다음은 어떤 경로로 이동할까요?');
    }else{
      setStatus('✓ f(n)을 정확히 계산했습니다. 다른 후보도 계속 확인하세요.');
    }
  }

  render();
}

function chooseNode(node){
  if(completed || !node.parent) return;
  const siblings=node.parent.children;

  if(!node.parent.expandedComplete){
    setStatus('먼저 현재 상태에서 가능한 후보를 모두 만들어야 합니다.','warn');
    return;
  }
  if(!siblings.every(n=>n.checked)){
    setStatus('먼저 모든 후보 상태의 f(n)을 정확히 계산하세요.','warn');
    return;
  }

  const best=Math.max(...siblings.map(n=>n.actual));
  if(node.actual!==best){
    setStatus('더 큰 f(n)을 가진 후보가 있습니다. 가장 좋은 상태를 다시 선택하세요.','warn');
    return;
  }

  siblings.forEach(n=>{
    n.rejected=n!==node;
    n.selected=n===node;
  });
  selectedPath.push(node);
  activeNode=node;

  if(node.actual===8){
    completed=true;
    const routeText=selectedPath.map(n=>'노드 '+n.id).join(' → ');
    const scoreText=selectedPath.map(n=>n.actual).join(' → ');
    setStatus(
      '✓ 탐색 완료! 목표 상태에 도달했습니다.'+
      '<div class="complete-summary">'+
      '<div class="summary-title">탐색 결과 요약</div>'+
      '<div>선택한 경로: '+routeText+'</div>'+
      '<div>f(n) 변화: '+scoreText+'</div>'+
      '</div>',
      'success'
    );
    celebrate();
  }else{
    setStatus('선택한 상태가 새로운 현재 노드가 되었습니다. 파란색 숫자를 움직여 다음 후보들을 모두 만들어 보세요.');
  }
  render();
  setTimeout(focusActiveNode,120);
}

function renderNode(node){
  const wrap=document.createElement('div');
  wrap.className='tree-node'+(node.fresh?' new-child':'');
  wrap.dataset.nodeId=node.id;

  const card=document.createElement('div');
  card.className='node-card';
  card.dataset.cardId=node.id;

  if(node===activeNode && !completed) card.classList.add('active');
  if(node.fresh) card.classList.add('new-result');
  if(node.selected) card.classList.add('selected');
  if(node.rejected) card.classList.add('rejected');
  if(node.actual===8) card.classList.add('goal');

  node.element=card;

  const head=document.createElement('div');
  head.className='node-head';
  head.innerHTML='<span class="node-num">'+node.id+'</span><span class="node-role">'+(node===rootNode?'초기 상태':node===activeNode?'현재 상태':'후보 상태')+'</span>';
  card.appendChild(head);

  const board=document.createElement('div');
  board.className='board';

  const canMove=(node===activeNode && node.checked && !node.expandedComplete && !completed);
  const moves=canMove ? possibleMoves(node.board,node.parent?node.parent.board:null) : [];

  node.board.forEach((row,r)=>row.forEach((v,c)=>{
    const isMoveable=moves.some(m=>m.r===r&&m.c===c);

    if(isMoveable){
      const btn=document.createElement('button');
      btn.type='button';
      btn.className='tile moveable';
      btn.textContent=v;
      btn.title='이 숫자를 빈칸으로 이동';
      const move=moves.find(m=>m.r===r&&m.c===c);
      btn.addEventListener('click',()=>generateChild(node,move,btn));
      board.appendChild(btn);
    }else if(v!==0 && !node.checked && (!canMove || node!==activeNode || node===rootNode)){
      const btn=document.createElement('button');
      btn.type='button';
      btn.className='tile score-selectable'+(node.selectedTiles.has(r+'-'+c)?' score-selected':'');
      btn.textContent=v;
      btn.title='목표 위치와 같다고 생각하면 클릭';
      btn.addEventListener('click',()=>toggleScoreTile(node,r,c));
      board.appendChild(btn);
    }else{
      const d=document.createElement('div');
      d.className='tile'+(v===0?' blank':'');
      d.textContent=v===0?'-':v;
      if(node.selectedTiles.has(r+'-'+c)) d.classList.add('score-selected');
      board.appendChild(d);
    }
  }));
  card.appendChild(board);

  if(canMove){
    const hint=document.createElement('div');
    hint.className='move-hint';
    hint.textContent='파란색 숫자를 클릭해 후보 생성';
    card.appendChild(hint);
    const total=possibleMoves(node.board,node.parent?node.parent.board:null).length;
    const prog=document.createElement('div');
    prog.className='progress';
    prog.textContent='후보 생성 '+node.children.length+' / '+total;
    card.appendChild(prog);
  }

  const scoreArea=document.createElement('div');
  scoreArea.className='score-area';

  const scoreLocked =
    node.parent &&
    !node.parent.expandedComplete &&
    !node.checked;

  if(scoreLocked){
    const locked=document.createElement('div');
    locked.className='score-locked';
    const total=possibleMoves(
      node.parent.board,
      node.parent.parent ? node.parent.parent.board : null
    ).length;
    locked.innerHTML=
      '먼저 현재 상태에서 가능한 후보를 모두 만들어 주세요.<br>'+
      '후보 생성 <b>'+node.parent.children.length+' / '+total+'</b>';
    card.appendChild(locked);
  }else{
  if(node.checked){
    const line=document.createElement('div');
    line.className='fn-display';
    line.innerHTML='f(n) = <span class="fn-value ok">'+node.actual+'</span>';
    scoreArea.appendChild(line);
    const note=document.createElement('div');
    note.className='node-note';
    note.textContent='✓ 계산 확인';
    scoreArea.appendChild(note);
  }else{
    const guide=document.createElement('div');
    guide.className='score-guide';
    guide.textContent='맞는 위치의 숫자를 클릭하거나 f(n)을 직접 입력하세요. 정답이면 자동으로 확인됩니다.';
    scoreArea.appendChild(guide);

    const line=document.createElement('div');
    line.className='fn-display';

    const input=document.createElement('input');
    input.className='fn-input';
    input.type='number';
    input.min='0';
    input.max='8';
    input.inputMode='numeric';
    input.value=node.manualInput || '';
    input.placeholder='0';
    input.setAttribute('aria-label','노드 '+node.id+' f(n) 입력');

    input.addEventListener('input',()=>{
      // 직접 입력하면 클릭 선택 방식은 초기화
      node.selectedTiles.clear();
      node.manualInput=input.value;

      const raw=input.value.trim();
      if(raw==='') return;

      const val=Number(raw);
      if(Number.isInteger(val) && val>=0 && val<=8){
        verifyScore(node,input,false);
      }else{
        setStatus('f(n)은 0~8 사이의 정수로 입력하세요.','warn');
      }
    });

    line.append('f(n) = ',input);
    scoreArea.appendChild(line);
  }

  if(node.parent && node.checked && node.parent.expandedComplete && !node.selected && !node.rejected && !completed){
    const siblings=node.parent.children;
    if(siblings.every(n=>n.checked)){
      card.classList.add('selectable-choice');
      card.title='카드를 클릭해 이 경로를 선택';
      card.addEventListener('click',(e)=>{
        if(e.target.closest('button, input')) return;
        chooseNode(node);
      });

      const chooseHint=document.createElement('div');
      chooseHint.className='choice-hint';
      chooseHint.textContent='카드를 클릭해 이 경로 선택';
      scoreArea.appendChild(chooseHint);
    }
  }

    card.appendChild(scoreArea);
  }
  wrap.appendChild(card);

  if(node.children.length){
    const kids=document.createElement('div');
    kids.className='children';
    node.children.forEach(ch=>kids.appendChild(renderNode(ch)));
    wrap.appendChild(kids);
  }

  return wrap;
}

function drawLinks(){
  const stage=document.getElementById('treeStage');
  const svg=document.getElementById('linkSvg');
  const sRect=stage.getBoundingClientRect();

  svg.setAttribute('viewBox','0 0 '+stage.scrollWidth+' '+stage.scrollHeight);
  svg.innerHTML='';

  function walk(node){
    if(node.parent && node.element && node.parent.element){
      const a=node.parent.element.getBoundingClientRect();
      const b=node.element.getBoundingClientRect();

      const x1=a.left-sRect.left+a.width/2+stage.scrollLeft;
      const y1=a.top-sRect.top+a.height+stage.scrollTop;
      const x2=b.left-sRect.left+b.width/2+stage.scrollLeft;
      const y2=b.top-sRect.top+stage.scrollTop;

      const mid=(y1+y2)/2;
      const path=document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('d',`M ${x1} ${y1} C ${x1} ${mid}, ${x2} ${mid}, ${x2} ${y2}`);
      path.setAttribute('fill','none');
      path.setAttribute('stroke', node.selected ? '#514779' : '#5d7897');
      path.setAttribute('stroke-width', node.selected ? '3.4' : '2.2');
      path.setAttribute('stroke-linecap','round');
      if(node.rejected) path.setAttribute('opacity','.45');
      if(node.fresh) path.classList.add('tree-link-new');
      svg.appendChild(path);
    }
    node.children.forEach(walk);
  }
  walk(rootNode);
}

function getPhase(){
  if(completed) return 4;
  if(selectedPath.length===0 || !rootNode.checked) return 0;
  if(activeNode && !activeNode.expandedComplete) return 1;

  if(activeNode && activeNode.expandedComplete){
    const children=activeNode.children;
    if(children.length && !children.every(n=>n.checked)) return 2;
    if(children.length && children.every(n=>n.checked)) return 3;
  }
  return 1;
}

function updatePhaseUI(){
  const phase=getPhase();
  const initial=document.getElementById('initialPhase');
  const wrap=document.getElementById('phaseWrap');

  if(phase===0){
    initial.style.display='block';
    wrap.style.opacity='.55';
  }else{
    initial.style.display='none';
    wrap.style.opacity='1';
  }

  [1,2,3].forEach(i=>{
    const el=document.getElementById('phase'+i);
    el.classList.remove('active','done');
    if(phase===4 || i<phase) el.classList.add('done');
    if(i===phase) el.classList.add('active');
  });
}

function focusActiveNode(){
  if(!activeNode || !activeNode.element) return;
  activeNode.element.scrollIntoView({
    behavior:'smooth',
    block:'center',
    inline:'center'
  });
}

function getPathSummary(){
  return selectedPath.length
    ? selectedPath.map(n=>'노드 '+n.id).join(' → ')
    : '-';
}

function getScoreSummary(){
  return selectedPath.length
    ? selectedPath.map(n=>n.actual).join(' → ')
    : '-';
}

function render(){
  const host=document.getElementById('treeRoot');
  host.innerHTML='';
  host.appendChild(renderNode(rootNode));

  document.getElementById('pathText').textContent=
    selectedPath.length
      ? selectedPath.map(n=>'노드 '+n.id+' (f='+n.actual+')').join(' → ')
      : '-';
  document.getElementById('scoreText').textContent=getScoreSummary();

  updatePhaseUI();
  requestAnimationFrame(drawLinks);
}

function reset(){
  nextId=1;
  completed=false;
  moveAnimating=false;
  selectedPath=[];
  rootNode=makeNode(START,null);
  activeNode=rootNode;
  render();
  setStatus('초기 상태에서 목표 위치와 일치하는 숫자들을 직접 클릭하여 f(n)을 계산하세요.');
}

function celebrate(){
  const layer=document.getElementById('confetti');
  const colors=['#2563eb','#22c55e','#f59e0b','#ef4444','#a855f7','#06b6d4'];
  layer.innerHTML='';
  for(let i=0;i<65;i++){
    const p=document.createElement('i');
    p.className='piece';
    p.style.left=(Math.random()*100)+'%';
    p.style.background=colors[Math.floor(Math.random()*colors.length)];
    p.style.animationDelay=(Math.random()*.25)+'s';
    p.style.setProperty('--dx',(Math.random()*180-90)+'px');
    p.style.setProperty('--rot',(Math.random()*800-400)+'deg');
    layer.appendChild(p);
  }
  setTimeout(()=>layer.innerHTML='',2200);
}

document.getElementById('helpBtn').addEventListener('click',()=>{
  const panel=document.getElementById('helpPanel');
  const hidden=panel.hasAttribute('hidden');
  if(hidden) panel.removeAttribute('hidden');
  else panel.setAttribute('hidden','');
});
document.getElementById('resetBtn').addEventListener('click',reset);
window.addEventListener('resize',()=>requestAnimationFrame(drawLinks));

renderStaticBoard(document.getElementById('goalBoard'),GOAL);
reset();
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
(()=>{
  const captureButtons=[...document.querySelectorAll('.capture-btn')];
  const toast=document.getElementById('captureToast');
  let toastTimer=null;

  function showCaptureToast(message,type='success'){
    clearTimeout(toastTimer);
    toast.textContent=message;
    toast.className=type;
    toast.hidden=false;
    toastTimer=setTimeout(()=>{ toast.hidden=true; },3200);
  }

  function isCompleted(statusEl){
    return !!statusEl && statusEl.textContent.includes('탐색 완료');
  }

  function syncCaptureButton(btn){
    const statusEl=document.getElementById(btn.dataset.status);
    const ready=isCompleted(statusEl);
    btn.disabled=!ready;
    const controls=btn.closest('.capture-controls');
    const help=controls?.querySelector('.capture-help');
    controls?.classList.toggle('ready',ready);
    if(help){
      help.textContent=ready
        ? '버튼을 누른 뒤 활동지에서 Ctrl+V로 붙여넣으세요.'
        : '탐색 완료 후 활성화됩니다.';
    }
    btn.title=ready
      ? '완료 화면을 캡처합니다.'
      : '탐색 완료 후 캡처할 수 있습니다.';
  }

  async function copyCanvasToClipboard(canvas){
    const blob=await new Promise((resolve,reject)=>{
      canvas.toBlob(b=>b ? resolve(b) : reject(new Error('이미지 변환 실패')),'image/png');
    });

    // Chrome/Edge + HTTPS(GitHub Pages 등)에서 가장 안정적인 방식
    if(navigator.clipboard?.write && window.ClipboardItem){
      await navigator.clipboard.write([
        new ClipboardItem({'image/png':blob})
      ]);
      return true;
    }

    // 로컬 파일 등에서 Clipboard API가 제한될 때 시도하는 보조 방식
    const img=document.createElement('img');
    img.src=canvas.toDataURL('image/png');
    const holder=document.createElement('div');
    holder.contentEditable='true';
    holder.style.position='fixed';
    holder.style.left='-10000px';
    holder.style.top='0';
    holder.appendChild(img);
    document.body.appendChild(holder);

    await new Promise(resolve=>{
      if(img.complete) resolve();
      else img.onload=resolve;
    });

    const range=document.createRange();
    range.selectNodeContents(holder);
    const selection=window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
    const ok=document.execCommand('copy');
    selection.removeAllRanges();
    holder.remove();
    if(!ok) throw new Error('클립보드 복사 실패');
    return true;
  }

  async function captureAndCopy(btn){
    if(btn.disabled) return;

    const target=document.getElementById(btn.dataset.target);
    if(!target) return;

    if(typeof window.html2canvas!=='function'){
      showCaptureToast('캡처 기능을 불러오지 못했습니다. 인터넷 연결을 확인해 주세요.','warn');
      return;
    }

    const originalText=btn.textContent;
    btn.disabled=true;
    btn.textContent='캡처 중...';

    try{
      const stage=target.querySelector('.tree-stage');
      const captureWidth=Math.max(
        target.scrollWidth,
        target.clientWidth,
        stage ? stage.scrollWidth + 48 : 0
      );
      const captureHeight=Math.max(target.scrollHeight,target.clientHeight);

      const preferredScale=Math.min(2,window.devicePixelRatio||1.5);
      const maxDimension=Math.max(captureWidth,captureHeight);
      const safeScale=Math.max(.75,Math.min(preferredScale,12000/Math.max(1,maxDimension)));

      const canvas=await html2canvas(target,{
        backgroundColor:'#ffffff',
        scale:safeScale,
        useCORS:true,
        logging:false,
        width:captureWidth,
        height:captureHeight,
        windowWidth:Math.max(document.documentElement.clientWidth,captureWidth),
        windowHeight:Math.max(document.documentElement.clientHeight,captureHeight),
        onclone:(doc)=>{
          const cloneStage=doc.querySelector('#'+target.id+' .tree-stage');
          const cloneTarget=doc.getElementById(target.id);
          if(cloneStage && stage){
            cloneStage.style.overflow='visible';
            cloneStage.style.width=stage.scrollWidth+'px';
            cloneStage.style.maxWidth='none';
          }
          if(cloneTarget && stage){
            cloneTarget.style.width=captureWidth+'px';
            cloneTarget.style.maxWidth='none';
          }
        }
      });

      await copyCanvasToClipboard(canvas);
      showCaptureToast('캡처가 완료되었습니다. 활동지로 돌아가 붙여넣으세요. (Ctrl + V)','success');
    }catch(err){
      console.error(err);
      showCaptureToast('자동 복사가 차단되었습니다. GitHub Pages(https)에서 열거나 브라우저의 클립보드 권한을 허용해 주세요.','warn');
    }finally{
      btn.textContent=originalText;
      syncCaptureButton(btn);
    }
  }

  captureButtons.forEach(btn=>{
    const statusEl=document.getElementById(btn.dataset.status);
    syncCaptureButton(btn);

    if(statusEl){
      new MutationObserver(()=>syncCaptureButton(btn)).observe(statusEl,{
        childList:true,
        subtree:true,
        characterData:true,
        attributes:true,
        attributeFilter:['class']
      });
    }
    btn.addEventListener('click',()=>captureAndCopy(btn));
  });
})();
</script>

