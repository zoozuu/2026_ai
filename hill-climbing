    }

    if(pathCells2.length && pathCells2[0][0]===r && pathCells2[0][1]===c) d.classList.add('start');
    if(pos2 && valid.length>0 && pos2[0]===r && pos2[1]===c) d.classList.add('current');
    if(valid.length>0 && adjacent.some(([vr,vc])=>vr===r&&vc===c)) d.classList.add('candidate');

    const num=document.createElement('span');
    num.className='num';
    num.textContent=v;
    d.appendChild(num);

    d.onclick=()=>clickGrid2(r,c);
    g.appendChild(d);
  }));
}

function clickGrid2(r,c){
  if(!pos2) return;

  const isNb=neighbors(data2,...pos2).some(([nr,nc])=>nr===r&&nc===c);
  if(isNb && data2[r][c]>data2[pos2[0]][pos2[1]]){
    pos2=[r,c];
    path2.push(data2[r][c]);
    pathCells2.push([r,c]);
    update2();
  } else if (isNb) {
    const cur = data2[pos2[0]][pos2[1]];
    const status=document.getElementById('status2');
    const chosen=data2[r][c];
    status.className='status';
    status.innerHTML = `
      현재 값 <b>${cur}</b> → 선택한 값 <b>${chosen}</b><br>
      선택한 값이 현재 값보다 크지 않으므로 <b>이동하지 않습니다.</b><br>
      더 큰 이웃을 선택하세요. · 이동 경로: <span class="path">${path2.join(' → ')}</span>
    `;
  }
}

function update2(){
  renderGrid2();
  const cur=data2[pos2[0]][pos2[1]];
  const valid=neighbors(data2,...pos2).filter(([r,c])=>data2[r][c]>cur);
  const maxVal=Math.max(...data2.flat());
  const startVal=path2[0];
  const status=document.getElementById('status2');

  if(valid.length){
    status.className='status';
    status.innerHTML=`랜덤 시작값 <b>${startVal}</b> · 현재 값 <b>${cur}</b> · 주변 이웃 4방향을 비교해 더 큰 값으로 이동하세요. · 이동 경로: <span class="path">${path2.join(' → ')}</span>`;
  } else if(cur===maxVal){
    status.className='status complete-success';
    status.innerHTML=`
      <span class="complete-title">✓ 탐색 완료</span>
      <b>최종 상태의 f(n)은 ${cur}</b>이며, 전체 최고점에 도달했습니다.
      <span class="complete-detail">이동 경로</span>
      <span class="complete-path">${path2.join(' → ')}</span>
    `;
    celebrate('status2');
  } else {
    status.className='status complete-local';
    status.innerHTML=`
      <span class="complete-title">! 탐색 완료</span>
      <b>지역 최댓값 f(n)=${cur}</b>에서 탐색이 종료되었습니다.
      <span class="complete-detail">탐색 종료 후 공개: 전체 최고점의 f(n)은 <b>${maxVal}</b>입니다.</span>
      <span class="complete-path">${path2.join(' → ')}</span>
    `;
  }
}

function autoBest2(){
  if(!pos2) return;
  const cur=data2[pos2[0]][pos2[1]];
  const valid=neighbors(data2,...pos2).filter(([r,c])=>data2[r][c]>cur);
  if(!valid.length){ update2(); return; }

  valid.sort((a,b)=>data2[b[0]][b[1]]-data2[a[0]][a[1]]);
  pos2=[...valid[0]];
  path2.push(data2[pos2[0]][pos2[1]]);
  pathCells2.push([...pos2]);
  update2();
}

function resetGrid2(){
  pos2=randomTrapStart2();
  path2=[data2[pos2[0]][pos2[1]]];
  pathCells2=[[...pos2]];
  update2();
}

/* init */
resetGrid1();
resetGrid2();
