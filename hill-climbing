function toggleAnswer(id){
  const el=document.getElementById(id);
  el.style.display = el.style.display==='block' ? 'none':'block';
}

function celebrate(targetId){
  const layer=document.getElementById('confettiLayer');
  const colors=['#2563eb','#22c55e','#f59e0b','#ef4444','#a855f7','#06b6d4','#facc15'];
  layer.innerHTML='';

  for(let i=0;i<70;i++){
    const piece=document.createElement('div');
    piece.className='confetti-piece';
    piece.style.left=(Math.random()*100)+'vw';
    piece.style.background=colors[Math.floor(Math.random()*colors.length)];
    piece.style.animationDelay=(Math.random()*0.35)+'s';
    piece.style.animationDuration=(1.4+Math.random()*1.1)+'s';
    piece.style.setProperty('--drift', ((Math.random()*180)-90)+'px');
    piece.style.setProperty('--spin', ((Math.random()*900)-450)+'deg');
    piece.style.width=(7+Math.random()*6)+'px';
    piece.style.height=(10+Math.random()*12)+'px';
    layer.appendChild(piece);
  }

  const target=document.getElementById(targetId);
  if(target){
    target.classList.remove('celebrate-pop');
    void target.offsetWidth;
    target.classList.add('celebrate-pop');
  }

  setTimeout(()=>{ layer.innerHTML=''; }, 2800);
}


/* ---------- 실습 1 ---------- */
const data1 = [
  [2,5,4,7,3],
  [3,6,8,9,5],
  [1,7,12,10,6],
  [4,8,11,9,7],
  [2,5,7,8,4]
];
let pos1=null, path1=[], pathCells1=[];

function neighbors(data,r,c){
  return [[r-1,c],[r+1,c],[r,c-1],[r,c+1]].filter(([nr,nc]) =>
    nr>=0 && nr<data.length && nc>=0 && nc<data[0].length
  );
}

function randomStart1(){
  const maxVal=Math.max(...data1.flat());
  const candidates=[];
  data1.forEach((row,r)=>row.forEach((v,c)=>{
    if(v!==maxVal) candidates.push([r,c]);
  }));
  return candidates[Math.floor(Math.random()*candidates.length)];
}

function renderGrid1(){
  const g=document.getElementById('grid1');
  g.style.gridTemplateColumns=`repeat(${data1[0].length},1fr)`;
  g.innerHTML='';
  const maxVal=Math.max(...data1.flat());
  const adjacent=pos1 ? neighbors(data1,...pos1) : [];
  const valid=pos1 ? adjacent.filter(([r,c])=>data1[r][c]>data1[pos1[0]][pos1[1]]) : [];

  data1.forEach((row,r)=>row.forEach((v,c)=>{
    const d=document.createElement('div');
    d.className='cell';

    const pathIndex=pathCells1.findIndex(([pr,pc])=>pr===r&&pc===c);
    if(pathIndex>=0){
      d.classList.add('visited');
      const badge=document.createElement('span');
      badge.className='step-badge';
      badge.textContent=pathIndex+1;
      d.appendChild(badge);
    }

    if(pathCells1.length && pathCells1[0][0]===r && pathCells1[0][1]===c) d.classList.add('start');
    if(pos1 && valid.length>0 && pos1[0]===r && pos1[1]===c) d.classList.add('current');
    if(valid.length>0 && adjacent.some(([vr,vc])=>vr===r&&vc===c)) d.classList.add('candidate');

    const num=document.createElement('span');
    num.className='num';
    num.textContent=v;
    d.appendChild(num);

    d.onclick=()=>clickGrid1(r,c);
    g.appendChild(d);
  }));
}

function clickGrid1(r,c){
  if(!pos1) return;

  const isNb=neighbors(data1,...pos1).some(([nr,nc])=>nr===r&&nc===c);
  if(isNb && data1[r][c]>data1[pos1[0]][pos1[1]]){
    pos1=[r,c];
    path1.push(data1[r][c]);
    pathCells1.push([r,c]);
    update1();
  } else if (isNb) {
    const cur = data1[pos1[0]][pos1[1]];
    const status=document.getElementById('status1');
    const chosen=data1[r][c];
    status.className='status';
    status.innerHTML = `
      현재 값 <b>${cur}</b> → 선택한 값 <b>${chosen}</b><br>
      선택한 값이 현재 값보다 크지 않으므로 <b>이동하지 않습니다.</b><br>
      더 큰 이웃을 선택하세요. · 이동 경로: <span class="path">${path1.join(' → ')}</span>
    `;
  }
}

function update1(){
  renderGrid1();
  const cur=data1[pos1[0]][pos1[1]];
  const valid=neighbors(data1,...pos1).filter(([r,c])=>data1[r][c]>cur);
  const startVal=path1[0];
  const status=document.getElementById('status1');

  if(valid.length){
    status.className='status';
    status.innerHTML=`랜덤 시작값 <b>${startVal}</b> · 현재 값 <b>${cur}</b> · 주변 이웃 4방향을 비교해 더 큰 값으로 이동하세요. · 이동 경로: <span class="path">${path1.join(' → ')}</span>`;
  } else {
    status.className='status complete-success';
    status.innerHTML=`
      <span class="complete-title">✓ 탐색 완료</span>
      <b>최종 상태의 f(n)은 ${cur}</b>이며, 전체 최고점에 도달했습니다.
      <span class="complete-detail">이동 경로</span>
      <span class="complete-path">${path1.join(' → ')}</span>
    `;
    celebrate('status1');
  }
}

function autoBest1(){
  if(!pos1) return;
  const cur=data1[pos1[0]][pos1[1]];
  const valid=neighbors(data1,...pos1).filter(([r,c])=>data1[r][c]>cur);
  if(!valid.length){ update1(); return; }
  valid.sort((a,b)=>data1[b[0]][b[1]]-data1[a[0]][a[1]]);
  pos1=[...valid[0]];
  path1.push(data1[pos1[0]][pos1[1]]);
  pathCells1.push([...pos1]);
  update1();
}

function resetGrid1(){
  pos1=randomStart1();
  path1=[data1[pos1[0]][pos1[1]]];
  pathCells1=[[...pos1]];
  update1();
}

/* ---------- 실습 2 ---------- */
const data2 = [
  [2,4,5,3,2],
  [3,8,7,4,3],
  [4,6,5,6,5],
  [3,5,7,12,8],
  [2,4,6,9,7]
];
let pos2=null, path2=[], pathCells2=[];

function randomTrapStart2(){
  // 지역 최댓값 8 쪽으로 흘러가기 쉬운 시작 후보만 사용
  const candidates = [
    [0,0],[0,1],[0,2],
    [1,0],[1,1],[1,2],
    [2,0],[2,1]
  ];
