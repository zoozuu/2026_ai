<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>언덕 등반 탐색 실습</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
    background: #f4f6f8;
    color: #1f2937;
  }
  header {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    padding: 22px 18px 14px;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  header .inner, main { max-width: 1260px; margin: 0 auto; }
  h1 { font-size: 26px; margin: 0 0 8px; }
  .sub { color:#6b7280; margin:0; line-height:1.6; }
.tabs {
    display:flex; gap:8px; flex-wrap:wrap;
    margin-top:16px;
  }
  .tab {
    border:1px solid #d1d5db;
    background:#fff;
    padding:9px 13px;
    border-radius:10px;
    cursor:pointer;
    font-weight:700;
  }
  .tab.active {
    background:#111827;
    color:white;
    border-color:#111827;
  }
  main { padding: 22px 18px 50px; }
  .panel { display:none; }
  .panel.active { display:block; }
  .card {
    background:white;
    border:1px solid #e5e7eb;
    border-radius:16px;
    padding:18px;
    margin-bottom:16px;
    box-shadow: 0 4px 16px rgba(0,0,0,.04);
  }
  h2 { margin:0 0 10px; font-size:21px; }
  h3 { margin:0 0 10px; font-size:17px; }
  .rule {
    background:#f9fafb;
    border-left:4px solid #9ca3af;
    padding:12px 14px;
    border-radius:8px;
    line-height:1.7;
    margin:12px 0 16px;
  }
  .controls { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; }
  button {
    border:1px solid #cbd5e1;
    background:white;
    padding:9px 12px;
    border-radius:9px;
    cursor:pointer;
    font-weight:700;
  }
  button:hover { background:#f8fafc; }
  button.primary { background:#2563eb; border-color:#2563eb; color:#fff; }
  button.danger { background:#fff7ed; border-color:#fdba74; }
  .status {
    margin-top:12px; padding:12px 14px; border-radius:10px;
    background:#eff6ff; line-height:1.6;
  }
  .status.complete-success {
    background:#ecfdf5;
    border:2px solid #22c55e;
    padding:18px;
    text-align:center;
    font-size:18px;
    font-weight:800;
    box-shadow:0 6px 18px rgba(34,197,94,.12);
  }
  .status.complete-local {
    background:#fff7ed;
    border:2px solid #f59e0b;
    padding:18px;
    text-align:center;
    font-size:18px;
    font-weight:800;
    box-shadow:0 6px 18px rgba(245,158,11,.12);
  }
  .status .complete-title {
    display:block;
    font-size:23px;
    margin-bottom:6px;
  }
  .status .complete-detail {
    display:block;
    font-size:14px;
    font-weight:600;
    color:#4b5563;
    margin-top:6px;
  }
  .grid {
    display:grid;
    gap:7px;
    max-width:520px;
    margin:14px auto;
  }
  
  .cell {
    aspect-ratio:1/1;
    border:2px solid #d1d5db;
    background:white;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
    font-weight:800;
    cursor:pointer;
    user-select:none;
    position:relative;
    overflow:hidden;
    transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease;
  }
  .cell:hover { border-color:#93c5fd; transform: translateY(-1px); }
  .cell .num {
    position:relative;
    z-index:2;
    color:#111827;
  }
  .cell.current {
    outline:4px solid #2563eb;
    outline-offset:-4px;
    box-shadow: inset 0 0 0 9999px rgba(239,246,255,.35);
  }
  .cell.candidate {
    border-color:#60a5fa;
    box-shadow: inset 0 0 0 9999px rgba(240,249,255,.28);
  }
  .cell.best {
    box-shadow: inset 0 0 0 4px #16a34a;
  }
  .cell.visited {
    border-color:#f59e0b;
    box-shadow:
      inset 0 0 0 3px #f59e0b,
      inset 0 0 0 9999px rgba(245,158,11,.18);
  }
  .cell.visited.current {
    border-color:#2563eb;
    box-shadow:
      inset 0 0 0 9999px rgba(239,246,255,.35);
  }
  .cell.visited.best {
    border-color:#f59e0b;
    box-shadow:
      inset 0 0 0 3px #f59e0b,
      inset 0 0 0 6px #16a34a,
      inset 0 0 0 9999px rgba(245,158,11,.16);
  }
  .cell.candidate.best {
    box-shadow: inset 0 0 0 4px #16a34a, inset 0 0 0 9999px rgba(240,249,255,.20);
  }
  .cell.current.best {
    box-shadow: inset 0 0 0 4px #16a34a, inset 0 0 0 9999px rgba(239,246,255,.30);
  }
  .cell.visited.current.best {
    box-shadow: inset 0 0 0 4px #16a34a, inset 0 0 0 9999px rgba(239,246,255,.30);
  }
  .step-badge {
    position:absolute;
    top:4px;
    left:5px;
    min-width:18px;
    height:18px;
    padding:0 4px;
    border-radius:999px;
    background:#111827;
    color:white;
    font-size:10px;
    line-height:18px;
    text-align:center;
    font-weight:800;
    z-index:3;
  }
  .cell.start::after {
    content:"시작";
    position:absolute; bottom:2px; right:4px;
    font-size:10px; font-weight:700; color:#374151;
    background:rgba(255,255,255,.65);
    padding:1px 4px;
    border-radius:999px;
    z-index:3;
  }
  .legend { display:flex; gap:14px; flex-wrap:wrap; font-size:13px; color:#4b5563; margin-top:10px; }
  .dot { display:inline-block; width:13px; height:13px; border-radius:3px; margin-right:5px; vertical-align:-2px; border:2px solid; }
  .dot.current { background:#eff6ff; border-color:#2563eb; }
  .dot.cand { background:#f0f9ff; border-color:#60a5fa; }
  .dot.best { background:white; border-color:#16a34a; }
  .question {
    padding:12px 14px;
    border:1px dashed #cbd5e1;
    border-radius:10px;
    margin-top:14px;
    line-height:1.7;
  }
  .answer {
    display:none;
    margin-top:8px;
    padding:10px 12px;
    background:#f0fdf4;
    border-radius:8px;
  }
  .path {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size:18px;
    font-weight:800;
    letter-spacing:.3px;
  }
  .complete-detail .path,
  .complete-path {
    display:block;
    margin-top:10px;
    font-size:21px;
    font-weight:900;
    color:#111827;
    line-height:1.6;
  }

  /* 완료 축하 효과 */
  #confettiLayer {
    position:fixed;
    inset:0;
    pointer-events:none;
    overflow:hidden;
    z-index:9999;
  }
  .confetti-piece {
    position:absolute;
    top:-24px;
    width:10px;
    height:18px;
    opacity:.95;
    border-radius:2px;
    animation:confettiFall 1.8s ease-out forwards;
  }
  @keyframes confettiFall {
    0% {
      transform:translate3d(0,-10px,0) rotate(0deg);
      opacity:1;
    }
    100% {
      transform:translate3d(var(--drift), 105vh, 0) rotate(var(--spin));
      opacity:0;
    }
  }
  .celebrate-pop {
    animation:celebratePop .45s ease-out;
  }
  @keyframes celebratePop {
    0% { transform:scale(.94); }
    65% { transform:scale(1.035); }
    100% { transform:scale(1); }
  }
  @media (max-width:600px) {

    .queen-board { grid-template-columns:repeat(4, 60px); }
    .qcell { width:60px; height:60px; }
  }

/* ===== ③ 8-퍼즐 탐색 트리 ===== */

#p3 *{box-sizing:border-box}
#p3 .hc3-root{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans KR",sans-serif;background:#f3f4f1;color:#252a2d}
#p3 .hc3-main{max-width:1260px;margin:auto;padding:26px 18px 64px}
#p3 .hero{background:#fff;border:1px solid #dfe3da;border-radius:18px;padding:22px;margin-bottom:16px}
#p3 h1{margin:0 0 8px;font-size:28px}
#p3 .sub{margin:0;color:#64748b;line-height:1.65}
#p3 .rule{margin-top:16px;padding:13px 15px;border-radius:12px;background:#f8fafc;border-left:4px solid #64748b;line-height:1.75}
#p3 .topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:16px}
#p3 .goal{display:flex;align-items:center;gap:14px;padding:11px 14px;border:1px solid #e5e7eb;border-radius:14px;background:#fff}
#p3 .goal-title{
  font-weight:900;
  background:#d78a2c;
  color:white;
  padding:5px 10px;
  border-radius:7px;
}
#p3 button{min-height:42px;border:1px solid #cbd5e1;border-radius:10px;padding:8px 13px;background:#fff;font-weight:800;color:#1f2937;cursor:pointer}
#p3 button:hover{background:#f8fafc}
#p3 button:disabled{opacity:.45;cursor:not-allowed}

#p3 .workspace{
  position:relative;
  background:
    linear-gradient(to bottom,
      #ffffff 0 235px,
      #eef0ee 235px 500px,
      #ffffff 500px 765px,
      #eef0ee 765px 1030px,
      #ffffff 1030px);
  border:1px solid #dfe3da;
  border-radius:18px;
  padding:20px 18px 32px;
  overflow-x:auto;
}
#p3 .legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:#64748b;margin-bottom:16px}
#p3 .swatch{display:inline-block;width:13px;height:13px;border:2px solid;border-radius:4px;margin-right:5px;vertical-align:-2px}
#p3 .swatch.active{border-color:#514779;background:#f5f4fa}
#p3 .swatch.selected{border-color:#514779}
#p3 .swatch.rejected{border-color:#d1d5db;opacity:.55}

#p3 .tree-stage{position:relative;min-width:1000px;padding:8px 20px 36px}
#p3 #linkSvg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
#p3 .tree-root{position:relative;z-index:2;display:flex;justify-content:center}
#p3 .tree-node{display:flex;flex-direction:column;align-items:center;position:relative}
#p3 .children{display:flex;align-items:flex-start;justify-content:center;gap:34px;margin-top:58px}

#p3 .node-card{
  width:198px;
  border:3px solid #7daa4b;
  border-radius:14px;
  background:#f7faef;
  padding:11px;
  transition:border-color .15s,background .15s,opacity .15s,box-shadow .15s,transform .15s;
}
#p3 .node-card.active{
  border-color:#514779;
  background:#fbfbf8;
  box-shadow:0 0 0 3px rgba(81,71,121,.10);
}
#p3 .node-card.selected{
  border-color:#514779;
  background:#fbfbf8;
  box-shadow:0 0 0 3px rgba(81,71,121,.08);
}
#p3 .node-card.rejected{opacity:.48;filter:saturate(.75)}
#p3 .node-card.goal{
  border-color:#514779;
  background:#fffdf7;
}
#p3 .node-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}
#p3 .node-num{display:inline-flex;width:28px;height:28px;border-radius:50%;align-items:center;justify-content:center;background:#514779;color:#fff;font-size:13px;font-weight:900}
#p3 .node-role{
  font-size:12px;
  color:#5e6b56;
  font-weight:850;
  background:#eaf2df;
  padding:3px 7px;
  border-radius:6px;
}

#p3 .board{
  display:grid;
  grid-template-columns:repeat(3,52px);
  gap:0;
  width:max-content;
  margin:auto;
  border:1px solid #b9c99e;
}
#p3 .tile{
  width:52px;height:52px;
  border:1px solid #c6d2b4;
  border-radius:0;
  display:flex;align-items:center;justify-content:center;
  background:#f2f6e8;
  font-size:20px;font-weight:800;color:#2d3133;
  position:relative;
}
#p3 .tile.blank{
  background:#79a842;
  color:transparent;
  border:1px solid #79a842;
}
#p3 button.tile{padding:0;min-height:52px}
#p3 button.tile.moveable{
  border:2px solid #4e8bc9;
  background:#e8f1fb;
  color:#245b8f;
  box-shadow:inset 0 0 0 1px rgba(78,139,201,.12);
}
#p3 button.tile.moveable:hover{background:#d9e9f8}
#p3 .tile.score-selectable{cursor:pointer}
#p3 .tile.score-selected{
  background:#f2f6e8;
  color:#2d3133;
}
#p3 .tile.score-selected::before{
  content:"";
  position:absolute;
  width:35px;
  height:35px;
  border:2px solid #c76767;
  border-radius:50%;
  pointer-events:none;
}

/* 퍼즐 조각 이동 + 자식 노드 확장 */
#p3 .node-card.moving{
  position:relative;
  z-index:4;
}
#p3 .tile.slide-piece{
  z-index:12;
  transition:
    transform .38s cubic-bezier(.22,.9,.3,1),
    box-shadow .38s ease;
  box-shadow:0 7px 16px rgba(78,139,201,.25);
}
#p3 .tile.slide-target{
  background:#dfeccb !important;
  border-color:#7daa4b !important;
}
#p3 .tree-node.new-child{
  animation:nodeDrop .52s cubic-bezier(.18,.9,.28,1) both;
  transform-origin:top center;
}
@keyframes nodeDrop{
  0%{
    opacity:0;
    transform:translateY(-28px) scale(.96);
  }
  68%{
    opacity:1;
    transform:translateY(5px) scale(1.01);
  }
  100%{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}
#p3 .node-card.new-result{
  animation:resultPulse .65s ease-out;
}
@keyframes resultPulse{
  0%{box-shadow:0 0 0 0 rgba(81,71,121,.28)}
  45%{box-shadow:0 0 0 7px rgba(81,71,121,.10)}
  100%{box-shadow:0 0 0 0 rgba(81,71,121,0)}
}
#p3 .tree-link-new{
  stroke-dasharray:420;
  stroke-dashoffset:420;
  animation:linkDraw .52s ease-out forwards;
}
@keyframes linkDraw{
  to{stroke-dashoffset:0}
}
@media (prefers-reduced-motion: reduce){
  #p3 .tile.slide-piece{
    transition:none !important;
  }
  #p3 .tree-node.new-child, #p3 .node-card.new-result, #p3 .tree-link-new{
    animation:none !important;
  }
}

#p3 .move-hint{margin-top:8px;text-align:center;color:#2563eb;font-size:12px;font-weight:850}
#p3 .progress{margin-top:6px;text-align:center;color:#64748b;font-size:12px;font-weight:800}

#p3 .score-area{margin-top:10px;padding-top:10px;border-top:1px solid #eef2f7}
#p3 .score-locked{
  margin-top:10px;
  padding:9px 8px;
  border-top:1px solid #eef2f7;
  text-align:center;
  color:#8a6a2f;
  background:#fff8e8;
  border-radius:8px;
  font-size:12px;
  font-weight:800;
  line-height:1.5;
}
#p3 .score-guide{font-size:12px;color:#64748b;line-height:1.45;text-align:center;margin-bottom:7px}
#p3 .fn-display{display:flex;justify-content:center;align-items:center;gap:6px;font-weight:900;font-size:16px}
#p3 .fn-value{display:inline-flex;min-width:35px;height:34px;padding:0 9px;border-radius:9px;align-items:center;justify-content:center;background:#f1f5f9;border:1px solid #cbd5e1;font-size:18px}
#p3 .fn-value.ok{background:#dcfce7;border-color:#22c55e;color:#166534}
#p3 .fn-input{width:66px;height:38px;border:1.5px solid #cbd5e1;border-radius:9px;text-align:center;font-size:18px;font-weight:900;background:#fff}
#p3 .fn-input:focus{outline:3px solid rgba(37,99,235,.12);border-color:#60a5fa}
#p3 .small-btn{width:100%;min-height:36px;margin-top:7px;font-size:13px}
#p3 .select-btn{background:#f3e8ff;border-color:#c4b5fd}
#p3 .node-note{min-height:18px;margin-top:5px;text-align:center;font-size:12px;font-weight:800;color:#15803d}

#p3 .phase-wrap{
  margin:16px 0 18px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:0;
  flex-wrap:wrap;
}
#p3 .phase{
  display:flex;
  align-items:center;
  gap:7px;
  padding:8px 12px;
  border:1px solid #d7dbd2;
  background:#fff;
  color:#8a9187;
  font-size:13px;
  font-weight:850;
}
#p3 .phase:first-child{border-radius:10px 0 0 10px}
#p3 .phase:last-child{border-radius:0 10px 10px 0}
#p3 .phase.active{
  background:#edf4e3;
  border-color:#7daa4b;
  color:#557a30;
}
#p3 .phase.done{
  background:#f5f4fa;
  color:#514779;
}
#p3 .phase-dot{
  display:inline-flex;
  width:23px;height:23px;
  align-items:center;justify-content:center;
  border-radius:50%;
  border:1px solid currentColor;
  font-size:12px;
}
#p3 .initial-phase{
  margin-bottom:10px;
  text-align:center;
  font-size:13px;
  font-weight:850;
  color:#514779;
}


#p3 .top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
#p3 .help-panel{
  margin-top:12px;
  padding:14px 16px;
  border:1px solid #d8dfcf;
  background:#fbfcf8;
  border-radius:12px;
  line-height:1.65;
  color:#4b5563;
}
#p3 .help-title{
  font-weight:900;
  color:#514779;
  margin-bottom:8px;
}
#p3 .help-panel ul{margin:8px 0 0 18px;padding:0}
#p3 .help-panel li{margin:4px 0}
#p3 .node-card.selectable-choice{
  cursor:pointer;
  box-shadow:0 0 0 2px rgba(81,71,121,.06);
}
#p3 .node-card.selectable-choice:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 18px rgba(81,71,121,.10);
}
#p3 .choice-hint{
  margin-top:7px;
  text-align:center;
  font-size:12px;
  font-weight:850;
  color:#514779;
  background:#f5f4fa;
  border:1px solid #ddd7f4;
  border-radius:8px;
  padding:6px 8px;
}
#p3 .complete-summary{
  margin-top:10px;
  padding:12px 14px;
  border-radius:10px;
  background:#ffffff;
  border:1px solid #c9d8b7;
  line-height:1.7;
  font-size:16px;
  font-weight:800;
}
#p3 .complete-summary .summary-title{
  font-size:18px;
  font-weight:900;
  color:#166534;
  margin-bottom:4px;
}

#p3 .status{margin-top:16px;padding:14px 16px;border-radius:11px;background:#eef3e8;border:1px solid #c9d8b7;line-height:1.7}
#p3 .status.warn{background:#fff7ed;border:1px solid #fdba74}
#p3 .status.success{background:#ecfdf5;border:2px solid #22c55e;text-align:center;font-size:19px;font-weight:900}
#p3 .path{margin-top:12px;padding:12px 14px;border-radius:11px;background:#f8fafc;font-size:17px;font-weight:850;line-height:1.6}

#p3 #confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:5}
#p3 .piece{position:absolute;top:0;width:9px;height:14px;border-radius:2px;animation:fall 1.5s ease-out forwards}
@keyframes fall{to{transform:translate(var(--dx),650px) rotate(var(--rot));opacity:0}}
@media (max-width:700px){#p3 .hc3-main{padding:14px 10px 40px}#p3 .hero, #p3 .workspace{padding:14px}#p3 .tree-stage{min-width:940px}}

#p3 { width:100%; }
#p3 .hc3-root { margin:0; }
#p3 .hc3-main { max-width:none; padding:0; }


/* 완료 화면 캡처 + 클립보드 복사 */
.activity-title-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  flex-wrap:wrap;
  margin-bottom:10px;
}
.activity-title-row h1,
.activity-title-row h2{
  margin:0;
}
.capture-controls{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:8px;
  margin:0;
  flex:0 0 auto;
}
.capture-btn{
  border:1px solid #16a34a;
  background:#16a34a;
  color:#fff;
  padding:9px 13px;
  border-radius:9px;
  font-weight:850;
  cursor:pointer;
}
.capture-btn:hover:not(:disabled){background:#15803d;border-color:#15803d}
.capture-btn:disabled{
  background:#e5e7eb;
  color:#9ca3af;
  border-color:#d1d5db;
  cursor:not-allowed;
}
.capture-help{
  display:none;
}
#captureToast{
  position:fixed;
  right:22px;
  bottom:22px;
  z-index:99999;
  max-width:360px;
  padding:13px 16px;
  border-radius:12px;
  background:#111827;
  color:#fff;
  box-shadow:0 10px 30px rgba(0,0,0,.18);
  font-weight:750;
  line-height:1.5;
}
#captureToast.success{background:#166534}
#captureToast.warn{background:#9a3412}

